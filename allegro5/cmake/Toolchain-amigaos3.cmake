# Cross toolchain for classic AmigaOS 3.x.
# Canonical target: OpenAmigaGCC, libnix, 68040 + 68881.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR m68k)
set(AMIGAOS3 TRUE CACHE BOOL "Build for classic AmigaOS 3.x")

if(NOT DEFINED AMIGA_STOVE OR AMIGA_STOVE STREQUAL "")
    message(FATAL_ERROR
        "Set AMIGA_STOVE to the absolute path of the OpenAmigaGCC stove")
endif()
set(AMIGA_STOVE "${AMIGA_STOVE}" CACHE PATH
    "Absolute path of the OpenAmigaGCC stove")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
    AMIGA_STOVE AMIGA_PORT_PREFIX)

set(AMIGA_PREFIX "${AMIGA_STOVE}/prefix")
set(AMIGA_SYSROOT "${AMIGA_PREFIX}/m68k-amigaos")

set(CMAKE_C_COMPILER "${AMIGA_PREFIX}/bin/m68k-amigaos-gcc")
set(CMAKE_CXX_COMPILER "${AMIGA_PREFIX}/bin/m68k-amigaos-g++")
set(CMAKE_AR "${AMIGA_PREFIX}/bin/m68k-amigaos-ar" CACHE FILEPATH "")
set(CMAKE_RANLIB "${AMIGA_PREFIX}/bin/m68k-amigaos-ranlib" CACHE FILEPATH "")
set(CMAKE_STRIP "${AMIGA_PREFIX}/bin/m68k-amigaos-strip" CACHE FILEPATH "")

set(AMIGA_CPU_FLAGS "-m68040 -m68881" CACHE STRING "Target CPU and FPU")
set(AMIGA_RUNTIME "-mcrt=nix20" CACHE STRING "Amiga C runtime")
set(AMIGA_THREAD_FLAGS "-pthread" CACHE STRING "Thread personality")

set(CMAKE_C_FLAGS_INIT
    "${AMIGA_RUNTIME} ${AMIGA_CPU_FLAGS} ${AMIGA_THREAD_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT
    "${AMIGA_RUNTIME} ${AMIGA_CPU_FLAGS} ${AMIGA_THREAD_FLAGS}")
set(CMAKE_EXE_LINKER_FLAGS_INIT
    "${AMIGA_RUNTIME} ${AMIGA_CPU_FLAGS} ${AMIGA_THREAD_FLAGS}")

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(AMIGA_SDK_DEPS "${AMIGA_SYSROOT}/port-deps")
set(CMAKE_PREFIX_PATH "${AMIGA_SYSROOT};${AMIGA_SDK_DEPS}")
set(CMAKE_FIND_ROOT_PATH "${AMIGA_SYSROOT};${AMIGA_SDK_DEPS}")
if(DEFINED AMIGA_PORT_PREFIX AND NOT AMIGA_PORT_PREFIX STREQUAL "")
    list(PREPEND CMAKE_PREFIX_PATH "${AMIGA_PORT_PREFIX}")
    list(PREPEND CMAKE_FIND_ROOT_PATH "${AMIGA_PORT_PREFIX}")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(CMAKE_THREAD_LIBS_INIT "-lpthread")
set(THREADS_PREFER_PTHREAD_FLAG ON)

